#. Plugin Name of the plugin
#: wtranslator.php
msgid "WTranslator - WordPress Translation Plugin"
msgstr "WTranslator - плагін перекладу для WordPress"

#. Plugin URI of the plugin
#: wtranslator.php
msgid "https://wordpress.org/plugins/wtranslator/"
msgstr "https://wordpress.org/plugins/wtranslator/"

#. Description of the plugin
#: wtranslator.php
msgid "Professional website translation plugin powered by Google Translate. Fully functional standalone; no external API required."
msgstr "Професійний плагін перекладу веб-сайтів на базі Google Translate. Повністю функціональний автономний плагін; зовнішній API не потрібен."

