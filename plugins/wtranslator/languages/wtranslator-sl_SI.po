msgstr "https://wordpress.org/plugins/wtranslator/"

#. Description of the plugin
#: wtranslator.php
msgid "Professional website translation plugin powered by Google Translate. Fully functional standalone; no external API required."
msgstr "Profesionalni vtičnik za prevajanje spletnih strani, ki ga poganja Google Prevajalnik. Popolnoma funkcionalen samostojen program; zunanji API ni potreben."

