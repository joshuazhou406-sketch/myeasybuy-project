msgstr "Sjálfvirk skipting yfir á tungumál gesta"

#: includes/class-admin-settings.php:262
msgid "On first visit (no language cookie yet), suggests a language from the browser’s Accept-Language header, or from the Cloudflare country header when your site uses Cloudflare. No third-party geo APIs are used."
msgstr "Við fyrstu heimsókn (engin tungumálaköku ennþá), leggur til tungumál úr Accept-Language haus vafrans, eða úr landshaus Cloudflare þegar síðan þín notar Cloudflare. Engin landfræðileg forritaskil frá þriðja aðila eru notuð."

#: includes/class-admin-settings.php:267
msgid "Sub-directory URL & Sub-domain URL"
msgstr "Vefslóð undirmöppu og vefslóð undirléns"

#: includes/class-admin-settings.php:269
msgid "Sub-directory URL (e.g. example.com/ar/) and Sub-domain URL (e.g. es.example.com) are available in WTranslator Cloud — manage from one dashboard."
msgstr "Slóðir fyrir undirmöppur (t.d. example.com/ar/) og slóðir fyrir undirlén (t.d. es.example.com) eru tiltækar í WTranslator Cloud — stjórnið þeim frá einni mælaborði."

#: includes/class-admin-settings.php:272
msgid "WTranslator Cloud"
msgstr "WTranslator Cloud"

#: includes/class-admin-settings.php:287
msgid "Language Selection"
msgstr "Tungumálaval"

#: includes/class-admin-settings.php:288
msgid "Select which languages to enable"
msgstr "Veldu hvaða tungumál á að virkja"

#: includes/class-admin-settings.php:292
msgid "Check All"
msgstr "Merktu við allt"

#: includes/class-admin-settings.php:293
msgid "Uncheck All"
msgstr "Afveljið allt"

#: includes/class-admin-settings.php:326
msgid "Drag to reorder"
msgstr "Dragðu til að endurraða"

#: includes/class-admin-settings.php:332
msgid "HINT: To reorder the languages, simply drag and drop them in the list above."
msgstr "ÁBENDING: Til að endurraða tungumálunum skaltu einfaldlega draga og sleppa þeim í listann hér að ofan."

#: includes/class-admin-settings.php:349
msgid "Privacy & optional usage sharing"
msgstr "Persónuvernd og valfrjáls notkunardeiling"

#: includes/class-admin-settings.php:351
msgid "WTranslator works fully without sending any data to our servers. If you opt in, we only collect the details listed below to improve compatibility. You can turn this off anytime."
msgstr "WTranslator virkar að fullu án þess að senda nein gögn til netþjóna okkar. Ef þú velur að gera það söfnum við aðeins upplýsingunum sem taldar eru upp hér að neðan til að bæta samhæfni. Þú getur slökkt á þessu hvenær sem er."

#: includes/class-admin-settings.php:363
msgid "Allow sharing anonymous site details with wtranslator.com"
msgstr "Leyfa að deila nafnlausum upplýsingum um vefsíður með WTranslator.com"

#: includes/class-admin-settings.php:366
msgid "Shared when enabled: site URL, site name, plugin version, WordPress version, PHP version, and locale. No visitor content is sent."
msgstr "Deilt þegar virkt er: vefslóð, heiti vefs, útgáfa viðbótar, WordPress útgáfa, PHP útgáfa og tungumál. Ekkert efni gesta er sent."

#: includes/class-admin-settings.php:368
msgid "Privacy policy"
msgstr "Persónuverndarstefna"

#: includes/class-admin-settings.php:381
msgid "Also share the WordPress admin email for support tips (optional)"
msgstr "Deildu einnig netfangi WordPress stjórnanda til að fá ráðleggingar um aðstoð (valfrjálst)"

#: includes/class-admin-settings.php:392
msgid "Save Changes"
msgstr "Vista breytingar"

#: includes/class-admin-settings.php:409
msgid "Security check failed. Please try again."
msgstr "Öryggisathugun mistókst. Reyndu aftur."

#: includes/class-language-manager.php:666
msgid "Select Language"
msgstr "Veldu tungumál"

#: includes/class-usage-consent.php:142
msgid "Help improve WTranslator (optional)"
msgstr "Hjálpaðu til við að bæta WTranslator (valfrjálst)"

#: includes/class-usage-consent.php:146
msgid "If you allow it, WTranslator can share anonymous site details (site URL, WordPress/PHP/plugin versions, and locale) with wtranslator.com so we can improve compatibility. Translation keeps working either way. You can change this anytime in Settings → WTranslator → Privacy."
msgstr "Ef þú leyfir það getur WTranslator deilt nafnlausum upplýsingum um vefsíðuna (vefslóð, útgáfum af WordPress/PHP/viðbótum og staðsetningu) með WTranslator.com svo við getum bætt samhæfni. Þýðingin heldur áfram að virka hvort sem er. Þú getur breytt þessu hvenær sem er í Stillingar → WTranslator → Persónuvernd."

#: includes/class-usage-consent.php:154
msgid "Allow anonymous usage sharing"
msgstr "Leyfa nafnlausa notkunardeilingu"

#: includes/class-usage-consent.php:157
msgid "No thanks"
msgstr "Nei takk"

