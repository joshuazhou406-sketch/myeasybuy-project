msgid "WTranslator - WordPress Translation Plugin"
msgstr "WTranslator - WordPress dodatak za prevođenje"

#. Plugin URI of the plugin
#: wtranslator.php
msgid "https://wordpress.org/plugins/wtranslator/"
msgstr "https://wordpress.org/plugins/wtranslator/"

#. Description of the plugin
#: wtranslator.php
msgid "Professional website translation plugin powered by Google Translate. Fully functional standalone; no external API required."
msgstr "Profesionalni dodatak za prevođenje web stranica pokretan Google prevoditeljem. Potpuno funkcionalan samostalni program; nije potreban vanjski API."

