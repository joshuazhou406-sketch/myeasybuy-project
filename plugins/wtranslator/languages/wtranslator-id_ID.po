#. Plugin Name of the plugin
#: wtranslator.php
msgid "WTranslator - WordPress Translation Plugin"
msgstr "WTranslator - Plugin Terjemahan WordPress"

#. Plugin URI of the plugin
#: wtranslator.php
msgid "https://wordpress.org/plugins/wtranslator/"
msgstr "https://wordpress.org/plugins/wtranslator/"

#. Description of the plugin
#: wtranslator.php
msgid "Professional website translation plugin powered by Google Translate. Fully functional standalone; no external API required."
msgstr "Plugin terjemahan situs web profesional yang didukung oleh Google Translate. Berfungsi penuh dan berdiri sendiri; tidak memerlukan API eksternal."

