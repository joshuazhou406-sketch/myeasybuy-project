#. Plugin Name of the plugin
#: wtranslator.php
msgid "WTranslator - WordPress Translation Plugin"
msgstr "WTranslator - Programu-jalizi ya Tafsiri ya WordPress"

#. Plugin URI of the plugin
#: wtranslator.php
msgid "https://wordpress.org/plugins/wtranslator/"
msgstr "https://wordpress.org/plugins/wtranslator/"

#. Description of the plugin
#: wtranslator.php
msgid "Professional website translation plugin powered by Google Translate. Fully functional standalone; no external API required."
msgstr "Programu-jalizi ya kitaalamu ya tafsiri ya tovuti inayoendeshwa na Google Translate. Inafanya kazi kikamilifu peke yake; hakuna API ya nje inayohitajika."

