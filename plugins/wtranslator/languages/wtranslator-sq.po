msgstr "Përzgjedhësi CSS për elementin e mbështjellësit të personalizuar"

#: includes/class-admin-settings.php:208
msgid "Preview"
msgstr "Pamje paraprake"

#: includes/class-admin-settings.php:217
msgid "Same switcher appears on your site. Updates when you save."
msgstr "I njëjti ndërrues shfaqet në faqen tuaj. Përditësohet kur e ruani."

#: includes/class-admin-settings.php:228
msgid "Advanced Options"
msgstr "Opsione të Avancuara"

#: includes/class-admin-settings.php:230
msgid "Additional configuration options"
msgstr "Opsione shtesë të konfigurimit"

#: includes/class-admin-settings.php:243
msgid "Native Language Names"
msgstr "Emrat e Gjuhës Amtare"

#: includes/class-admin-settings.php:247
msgid "Show language names in their native form"
msgstr "Shfaq emrat e gjuhëve në formën e tyre amtare"

#: includes/class-admin-settings.php:258
msgid "Auto switch to visitor language"
msgstr "Kalimi automatik në gjuhën e vizitorit"

#: includes/class-admin-settings.php:262
msgid "On first visit (no language cookie yet), suggests a language from the browser’s Accept-Language header, or from the Cloudflare country header when your site uses Cloudflare. No third-party geo APIs are used."
msgstr "Në vizitën e parë (ende pa cookie gjuhe), sugjeron një gjuhë nga koka e Pranimit të Gjuhës së shfletuesit ose nga koka e vendit të Cloudflare kur faqja juaj përdor Cloudflare. Nuk përdoren API gjeografike të palëve të treta."

#: includes/class-admin-settings.php:267
msgid "Sub-directory URL & Sub-domain URL"
msgstr "URL-ja e nën-direktorisë dhe URL-ja e nën-domenit"

#: includes/class-admin-settings.php:269
msgid "Sub-directory URL (e.g. example.com/ar/) and Sub-domain URL (e.g. es.example.com) are available in WTranslator Cloud — manage from one dashboard."
msgstr "URL-ja e nën-drejtorisë (p.sh. example.com/ar/) dhe URL-ja e nën-domenit (p.sh. es.example.com) janë të disponueshme në WTranslator Cloud — menaxhohen nga një panel i vetëm."

#: includes/class-admin-settings.php:272
msgid "WTranslator Cloud"
msgstr "WTranslator Cloud"

#: includes/class-admin-settings.php:287
msgid "Language Selection"
msgstr "Përzgjedhja e gjuhës"

#: includes/class-admin-settings.php:288
msgid "Select which languages to enable"
msgstr "Zgjidhni cilat gjuhë do të aktivizohen"

#: includes/class-admin-settings.php:292
msgid "Check All"
msgstr "Kontrollo të gjitha"

#: includes/class-admin-settings.php:293
msgid "Uncheck All"
msgstr "Hiq shenjën të gjithave"

#: includes/class-admin-settings.php:326
msgid "Drag to reorder"
msgstr "Zvarrit për të rirenditur"

#: includes/class-admin-settings.php:332
msgid "HINT: To reorder the languages, simply drag and drop them in the list above."
msgstr "KËSHILLË: Për të rirenditur gjuhët, thjesht tërhiqini dhe lëshojini ato në listën më sipër."

#: includes/class-admin-settings.php:349
msgid "Privacy & optional usage sharing"
msgstr "Privatësia dhe ndarja opsionale e përdorimit"

#: includes/class-admin-settings.php:351
msgid "WTranslator works fully without sending any data to our servers. If you opt in, we only collect the details listed below to improve compatibility. You can turn this off anytime."
msgstr "WTranslator funksionon plotësisht pa dërguar të dhëna në serverat tanë. Nëse zgjidhni të aktivizoni, ne mbledhim vetëm detajet e listuara më poshtë për të përmirësuar përputhshmërinë. Mund ta çaktivizoni këtë në çdo kohë."

#: includes/class-admin-settings.php:363
msgid "Allow sharing anonymous site details with wtranslator.com"
msgstr "Lejo ndarjen e detajeve anonime të faqes me WTranslator.com"

#: includes/class-admin-settings.php:366
msgid "Shared when enabled: site URL, site name, plugin version, WordPress version, PHP version, and locale. No visitor content is sent."
msgstr "Ndahet kur aktivizohet: URL-ja e faqes, emri i faqes, versioni i plugin-it, versioni i WordPress-it, versioni i PHP-së dhe cilësimet lokale. Nuk dërgohet përmbajtje për vizitorët."

#: includes/class-admin-settings.php:368
msgid "Privacy policy"
msgstr "Politika e privatësisë"

#: includes/class-admin-settings.php:381
msgid "Also share the WordPress admin email for support tips (optional)"
msgstr "Gjithashtu ndani email-in e administratorit të WordPress për këshilla mbështetjeje (opsionale)"

#: includes/class-admin-settings.php:392
msgid "Save Changes"
msgstr "Ruaj ndryshimet"

#: includes/class-admin-settings.php:409
msgid "Security check failed. Please try again."
msgstr "Kontrolli i sigurisë dështoi. Ju lutemi provoni përsëri."

#: includes/class-language-manager.php:666
msgid "Select Language"
msgstr "Zgjidh Gjuhën"

#: includes/class-usage-consent.php:142
msgid "Help improve WTranslator (optional)"
msgstr "Ndihmoni në përmirësimin e WTranslator (opsionale)"

#: includes/class-usage-consent.php:146
msgid "If you allow it, WTranslator can share anonymous site details (site URL, WordPress/PHP/plugin versions, and locale) with wtranslator.com so we can improve compatibility. Translation keeps working either way. You can change this anytime in Settings → WTranslator → Privacy."
msgstr "Nëse e lejoni, WTranslator mund të ndajë detaje anonime të faqes (URL-në e faqes, versionet e WordPress/PHP/shtojcave dhe gjuhën lokale) me WTranslator.com në mënyrë që të përmirësojmë përputhshmërinë. Përkthimi vazhdon të funksionojë në të dyja rastet. Mund ta ndryshoni këtë në çdo kohë te Cilësimet → WTranslator → Privatësia."

#: includes/class-usage-consent.php:154
msgid "Allow anonymous usage sharing"
msgstr "Lejo ndarjen anonime të përdorimit"

#: includes/class-usage-consent.php:157
msgid "No thanks"
msgstr "Jo faleminderit"

#: includes/class-usage-consent.php:160
msgid "Privacy details"
msgstr "Detajet e privatësisë"

#: includes/class-usage-consent.php:173
msgid "You do not have permission to do this."
msgstr "Nuk ke leje për ta bërë këtë."

