#. Plugin Name of the plugin
#: wtranslator.php
msgid "WTranslator - WordPress Translation Plugin"
msgstr "WTranslator - Plugin de traducción para WordPress"

#. Plugin URI of the plugin
#: wtranslator.php
msgid "https://wordpress.org/plugins/wtranslator/"
msgstr "https://wordpress.org/plugins/wtranslator/"

#. Description of the plugin
#: wtranslator.php
msgid "Professional website translation plugin powered by Google Translate. Fully functional standalone; no external API required."
msgstr "Plugin profesional de traducción web con tecnología de Google Translate. Funciona de forma independiente y sin necesidad de API externas."

