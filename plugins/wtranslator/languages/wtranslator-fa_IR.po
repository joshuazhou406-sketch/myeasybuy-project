#. Plugin Name of the plugin
#: wtranslator.php
msgid "WTranslator - WordPress Translation Plugin"
msgstr "افزونه ترجمه وردپرس WTranslator"

#. Plugin URI of the plugin
#: wtranslator.php
msgid "https://wordpress.org/plugins/wtranslator/"
msgstr "https://wordpress.org/plugins/wtranslator/"

#. Description of the plugin
#: wtranslator.php
msgid "Professional website translation plugin powered by Google Translate. Fully functional standalone; no external API required."
msgstr "افزونه‌ی حرفه‌ای ترجمه‌ی وب‌سایت که توسط گوگل ترنسلیت پشتیبانی می‌شود. کاملاً کاربردی و مستقل؛ بدون نیاز به API خارجی."

