#. Plugin Name of the plugin
#: wtranslator.php
msgid "WTranslator - WordPress Translation Plugin"
msgstr "WTranslator - WordPress додатак за превођење"

#. Plugin URI of the plugin
#: wtranslator.php
msgid "https://wordpress.org/plugins/wtranslator/"
msgstr "https://wordpress.org/plugins/wtranslator/"

#. Description of the plugin
#: wtranslator.php
msgid "Professional website translation plugin powered by Google Translate. Fully functional standalone; no external API required."
msgstr "Професионални додатак за превођење веб страница помоћу Google преводиоца. Потпуно функционалан, самосталан; није потребан спољни API."

